# Mau cau hinh rieng tung may cho de tai NCKH Mekong.
# Sao chep thanh .env (KHONG commit .env - da co trong .gitignore) va dien gia tri that.
# Moi duong dan / ID tai khoan / khoa nhay cam dat o .env, khong ghi cung trong code (src/settings.py doc file nay).

# Thu muc du lieu goc (raster, nhan, bang dac trung, bang hop nhat). Vd: D:/du_lieu/mekong
DATA_ROOT=

# Google Earth Engine: Cloud project da bat Earth Engine API (scripts/gee_fetch.py, fix_era5_transform.py ...)
EE_PROJECT=
# Ten thu muc Google Drive nhan file xuat tu GEE
GEE_DRIVE_FOLDER=GEE

# Tuy chon (ghi de mac dinh trong DATA_ROOT): RAW_DIR, OUTPUT_DIR, ZENODO_DIR, GEE_DIR, LABELS_DIR, GRID_GEOJSON
